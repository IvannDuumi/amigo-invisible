{
  "rules": {
    "draws": {
      "$draw": {
        ".read": "$draw.length >= 10",
        "$person": {
          ".write": "!data.exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "links": {
      "$draw": {
        "$token": {
          ".read": true,
          ".write": "$draw.length >= 10 && $token.length >= 6",
          ".validate": "newData.isString() && newData.val().length < 8000"
        }
      }
    },
    "wkeys": {
      "$draw": {
        "$person": {
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().length >= 16"
        }
      }
    },
    "wishes": {
      "$draw": {
        "$person": {
          ".write": "newData.exists() && root.child('wkeys').child($draw).child($person).val() === newData.child('k').val()",
          "w": {
            ".read": true,
            ".validate": "newData.isString() && newData.val().length <= 600"
          },
          "k": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
